# Public source tree; local assets and experiments remain on disk.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/bondriver/
!/linux/
!/nixos/
!/windows/
!/firmware/
!/scripts/
!/tests/

/bondriver/*
!/bondriver/*.c
!/bondriver/*.cpp
!/bondriver/*.h
!/bondriver/*.ps1
!/bondriver/BonDriver_Torne.ini
!/bondriver/THIRD_PARTY_LICENSES.txt
!/bondriver/README.md
/linux/dist/
/linux/receiver/target/
/windows/*
!/windows/torne-zadig.cfg
!/windows/zadig.ini
/scripts/*
!/scripts/package-source.py
/tests/*
!/tests/native_torne.cpp
!/tests/test_source_distribution.py

# Firmware sources and deltas only. Old analysis requires private dumps.
/firmware/*
!/firmware/README.md
!/firmware/Cargo.toml
!/firmware/Cargo.lock
!/firmware/c/
!/firmware/src/
!/firmware/tests/
!/firmware/examples/
!/firmware/build-fr30.ps1
!/firmware/test-c.ps1
!/firmware/tools/
/firmware/tools/*
!/firmware/tools/apply-patch.py
!/firmware/tools/prepare-fr30.py
!/firmware/patches/

# Never publish original/patched firmware, modules, builds, captures or secrets.
**/target/
**/__pycache__/
**/.venv/
**/node_modules/
*.py[cod]
*.bin
*.elf
*.prx
*.sprx
*.pkg
*.PKG
*.iso
*.exe
*.dll
*.lib
*.o
*.obj
*.pdb
*.ax
*.ts
*.m2ts
*.pcap
*.pcapng
*.log
*.jsonl
*.zip
*.tar
*.gz
*.7z
.env
.env.*
*.pem
*.key
result
result-*
.DS_Store
Thumbs.db
